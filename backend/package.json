{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "seed:asset-permissions": "node scripts/seed-asset-permissions.js --apply",
    "backfill:tenant-accounts": "node scripts/backfill-tenant-accounts.js --apply",
    "backfill:meter-reading-amounts": "node scripts/backfill-meter-reading-amounts.js --apply",
    "check:currency": "node scripts/check-currency-backfill.js",
    "check:documents": "node scripts/check-document-files.js",
    "repair:settlement": "node scripts/repair-settlement-rounding.js --apply",
    "db:dump": "node scripts/dump-database.js",
    "db:restore": "node scripts/restore-database.js",
    "db:rebuild": "npm run db:dump && prisma migrate reset --force --skip-seed && node scripts/restore-database.js --apply",
    "test": "node --test src/modules/apartments/apartment.validation.test.js src/modules/auth/auth.service.test.js src/modules/invoice/invoice-line-currency.test.js src/modules/invoice/invoice.validation.test.js src/modules/lease-contracts/lease-contract.placeholders.test.js src/modules/leases/lease.validation.test.js src/modules/meter-readings/meter-reading.period.test.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
